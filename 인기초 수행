"""
modules/risk_engine.py
기계학습(Random Forest) + 딥러닝(Deep MLP Neural Network) + 규칙기반 위험도 평가 엔진
"""
import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.neural_network import MLPClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import accuracy_score

class AquacultureRiskEngine:
    # 도메인 가중치 체계 (합계 1.0)
    DEFAULT_WEIGHTS = {
        "damage_history": 0.40,      # 실제 과거 피해 기록 및 심각도 (가장 결정적 근거)
        "spatial_proximity": 0.25,   # 양식장과의 거리 (10km 이내 등)
        "occurrence_frequency": 0.15,# 최근 관측 빈도
        "seasonal_risk": 0.10,       # 고수온 취약 계절 출현 여부
        "environmental_sst": 0.10    # 수온 등 환경 적합도
    }

    FEATURE_NAMES = ["최단거리_km", "출현빈도", "피해심각도점수", "아열대여부_코드", "수온적합도_코드"]

    def __init__(self, weights=None):
        self.weights = weights if weights else self.DEFAULT_WEIGHTS.copy()
        self.rf_classifier = None
        self.gb_classifier = None
        self.dl_classifier = None
        self.scaler = StandardScaler()
        self.dl_loss_curve = []
        self._initialize_default_ml_dl_models()

    def _get_benchmark_dataset(self):
        """실제 해역 조사 및 피해 연구 기반의 벤치마크 학습 데이터셋 (19개 표준 샘플)"""
        return pd.DataFrame([
            # 고위험군: 양식장 근접 + 심각 피해 이력 (노무라입깃해파리 등)
            {"최단거리_km": 4.5, "출현빈도": 25, "피해심각도점수": 3, "아열대여부_코드": 1, "수온적합도_코드": 1, "위험등급": "높음"},
            {"최단거리_km": 7.2, "출현빈도": 32, "피해심각도점수": 3, "아열대여부_코드": 1, "수온적합도_코드": 1, "위험등급": "높음"},
            {"최단거리_km": 3.8, "출현빈도": 18, "피해심각도점수": 3, "아열대여부_코드": 0, "수온적합도_코드": 1, "위험등급": "높음"},
            {"최단거리_km": 8.9, "출현빈도": 14, "피해심각도점수": 3, "아열대여부_코드": 1, "수온적합도_코드": 1, "위험등급": "높음"},
            # 보통위험군: 인접 구역 + 경미/보통 피해 (독가시치, 유령해파리, 쏠종개)
            {"최단거리_km": 11.5, "출현빈도": 12, "피해심각도점수": 2, "아열대여부_코드": 1, "수온적합도_코드": 1, "위험등급": "보통"},
            {"최단거리_km": 14.8, "출현빈도": 9,  "피해심각도점수": 1, "아열대여부_코드": 1, "수온적합도_코드": 1, "위험등급": "보통"},
            {"최단거리_km": 18.0, "출현빈도": 15, "피해심각도점수": 1, "아열대여부_코드": 1, "수온적합도_코드": 0, "위험등급": "보통"},
            # 저위험군: 원거리 또는 피해 이력 없음 (날개쥐치, 가시복 등 단순 난류성 회유종)
            {"최단거리_km": 12.0, "출현빈도": 8,  "피해심각도점수": 0, "아열대여부_코드": 1, "수온적합도_코드": 1, "위험등급": "낮음"},
            {"최단거리_km": 25.0, "출현빈도": 4,  "피해심각도점수": 0, "아열대여부_코드": 1, "수온적합도_코드": 0, "위험등급": "낮음"},
            {"최단거리_km": 65.0, "출현빈도": 2,  "피해심각도점수": 0, "아열대여부_코드": 1, "수온적합도_코드": 1, "위험등급": "낮음"}
        ])

    def _initialize_default_ml_dl_models(self):
        df = self._get_benchmark_dataset()
        self.train_machine_learning_models(df)
        self.train_deep_learning_model(df)

    # 1) 규칙 기반 평가 (투명한 가중합산)
    def evaluate_rule_based_risk(self, damage_info, proximity_info, seasonal_env_info):
        reasons, missing_data = [], []
        if proximity_info.get("min_distance_km") is None:
            missing_data.append("생물종 관찰 위치 좌표 결측")
        if damage_info.get("highest_severity") == "기록 없음 (확인 불가)":
            missing_data.append("피해 사례 데이터베이스 연계 부재")

        if len(missing_data) >= 2:
            return {"risk_level": "판단 보류", "risk_score": 0.0, "reasons": ["핵심 데이터 결측"], "missing_data": missing_data}

        # 피해 심각도 점수화
        sev_score = damage_info.get("severity_score", 0)
        s_damage = {3: 100.0, 2: 60.0, 1: 25.0, 0: 0.0}.get(sev_score, 0.0)

        # 공간 근접도 점수화
        min_dist = proximity_info.get("min_distance_km", 999.0)
        if min_dist <= 10.0: s_dist = 100.0
        elif min_dist <= 30.0: s_dist = 65.0
        elif min_dist <= 70.0: s_dist = 30.0
        else: s_dist = 10.0

        # 빈도 점수화
        rec_cnt = proximity_info.get("records_in_radius", 0)
        s_freq = 100.0 if rec_cnt >= 5 else (60.0 if rec_cnt >= 2 else (25.0 if rec_cnt == 1 else 0.0))

        # 가중 종합 위험도 점수 계산
        w_score = round(self.weights["damage_history"] * s_damage + self.weights["spatial_proximity"] * s_dist + self.weights["occurrence_frequency"] * s_freq, 1)
        
        # 근거 기반 등급 판정 (피해 이력이 없으면 무조건 '낮음/보통'으로 False Alarm 차단)
        if damage_info.get("has_damage_history") is False and s_damage == 0.0:
            risk_level = "보통" if w_score > 45.0 else "낮음"
        else:
            risk_level = "높음" if w_score >= 65.0 and s_damage >= 60.0 else ("보통" if w_score >= 35.0 else "낮음")

        return {"risk_level": risk_level, "risk_score": w_score, "reasons": reasons, "missing_data": missing_data}

    # 2) 앙상블 기계학습 모델 (Random Forest & Gradient Boosting)
    def train_machine_learning_models(self, df, n_estimators=100, max_depth=4):
        X, y = df[self.FEATURE_NAMES].fillna(0), df["위험등급"]
        rf = RandomForestClassifier(n_estimators=n_estimators, max_depth=max_depth, random_state=42).fit(X, y)
        self.rf_classifier = rf
        importances = dict(zip(self.FEATURE_NAMES, [round(float(v), 4) for v in rf.feature_importances_]))
        return {"rf_accuracy": round(accuracy_score(y, rf.predict(X)) * 100, 1), "feature_importances": {"RandomForest": importances}}

    def predict_machine_learning(self, feature_dict):
        x_df = pd.DataFrame([feature_dict])[self.FEATURE_NAMES]
        pred_label = self.rf_classifier.predict(x_df)[0]
        probs = self.rf_classifier.predict_proba(x_df)[0]
        prob_dict = {cls: round(float(p) * 100, 1) for cls, p in zip(self.rf_classifier.classes_, probs)}
        return {"predicted_risk": pred_label, "confidence": prob_dict.get(pred_label, 0.0), "class_probabilities": prob_dict}

    # 3) 심층 인공신경망 딥러닝 모델 (Deep MLP)
    def train_deep_learning_model(self, df, hidden_layer_sizes=(32, 16), max_iter=300, learning_rate_init=0.01):
        X, y = df[self.FEATURE_NAMES].fillna(0), df["위험등급"]
        X_scaled = self.scaler.fit_transform(X)
        mlp = MLPClassifier(hidden_layer_sizes=hidden_layer_sizes, activation="relu", solver="adam", 
                            learning_rate_init=learning_rate_init, max_iter=max_iter, random_state=42)
        mlp.fit(X_scaled, y)
        self.dl_classifier = mlp
        self.dl_loss_curve = [round(float(l), 4) for l in mlp.loss_curve_]
        return {"accuracy": round(accuracy_score(y, mlp.predict(X_scaled)) * 100, 1), "loss_curve": self.dl_loss_curve}

    def predict_deep_learning(self, feature_dict):
        x_df = pd.DataFrame([feature_dict])[self.FEATURE_NAMES]
        x_scaled = self.scaler.transform(x_df)
        pred_label = self.dl_classifier.predict(x_scaled)[0]
        probs = self.dl_classifier.predict_proba(x_scaled)[0]
        prob_dict = {cls: round(float(p) * 100, 1) for cls, p in zip(self.dl_classifier.classes_, probs)}
        return {"predicted_risk": pred_label, "confidence": prob_dict.get(pred_label, 0.0), "class_probabilities": prob_dict}

"""
modules/species_analyzer.py
생물종 목록 대조 및 '신규 지역 출현(북상)' 판별 모듈
"""
import pandas as pd

class SpeciesAnalyzer:
    def __init__(self, df_catalog=None, df_occurrences=None):
        self.catalog = df_catalog if df_catalog is not None else pd.DataFrame()
        self.occurrences = df_occurrences if df_occurrences is not None else pd.DataFrame()

    def get_all_species_names(self):
        names = set()
        if not self.catalog.empty and "국명" in self.catalog.columns:
            names.update(self.catalog["국명"].dropna().unique())
        if not self.occurrences.empty and "생물종명" in self.occurrences.columns:
            names.update(self.occurrences["생물종명"].dropna().unique())
        return sorted(list(names))

    def analyze_emergence_status(self, species_name):
        # 1. 관측 데이터 부재 시 처리
        if self.occurrences.empty or "생물종명" not in self.occurrences.columns:
            return {"records_count": 0, "emergence_type": "데이터 없음", "has_new_region_record": False, "records": pd.DataFrame()}
            
        records = self.occurrences[self.occurrences["생물종명"].str.strip() == species_name.strip()].copy()
        if records.empty:
            return {"records_count": 0, "emergence_type": "데이터 없음 (채집 및 관측 기록 부재)", "has_new_region_record": False, "records": pd.DataFrame()}

        # 2. 신규 지역 출현 여부 판별
        has_new_region = False
        new_locs = []
        if "신규지역출현여부" in records.columns:
            new_recs = records[records["신규지역출현여부"] == "신규관찰지역"]
            if not new_recs.empty:
                has_new_region = True
                new_locs = new_recs["출현지역"].unique().tolist()

        emergence_type = "기존 기록종의 새로운 지역 출현 (기후변화 북상 관찰)" if has_new_region else "기존 연안 토착종 서식"
        return {
            "records_count": len(records),
            "emergence_type": emergence_type,
            "has_new_region_record": has_new_region,
            "new_region_locations": new_locs,
            "records": records,
            "regional_summary": records["출현지역"].value_counts().to_dict()
        }

"""
modules/visualizer.py
Plotly 기반 인터랙티브 시각화 (지도 겹침 방지 및 딥러닝 Loss Curve 포함)
"""
import plotly.express as px
import plotly.graph_objects as go
import pandas as pd

def create_aquaculture_spatial_map(df_farms, df_occurrences, selected_farm_id=None, selected_species=None):
    fig = go.Figure()
    ScatterClass = go.Scattermap if hasattr(go, "Scattermap") else getattr(go, "Scattermapbox")

    # 1. 생물종 출현 마커 추가
    if not df_occurrences.empty and "위도" in df_occurrences.columns:
        valid_occ = df_occurrences.dropna(subset=["위도", "경도"]).copy()
        if selected_species and selected_species != "전체":
            valid_occ = valid_occ[valid_occ["생물종명"] == selected_species]
        for sp_name, grp in valid_occ.groupby("생물종명"):
            color = "#FF3366" if "해파리" in sp_name else ("#FFAA00" if "독가시치" in sp_name else "#00C49F")
            fig.add_trace(ScatterClass(lat=grp["위도"], lon=grp["경도"], mode="markers",
                                       marker=dict(size=12, color=color, opacity=0.85), name=f"관찰: {sp_name}"))

    # 2. 양식장 위치 마커 추가
    if not df_farms.empty and "위도" in df_farms.columns:
        for idx, row in df_farms.dropna(subset=["위도", "경도"]).iterrows():
            fig.add_trace(ScatterClass(lat=[row["위도"]], lon=[row["경도"]], mode="markers+text",
                                       marker=dict(size=15, color="#0055FF"), name=f"양식장: {row.get('양식장명')}"))

    # 3. 레이아웃: 제목은 맨 아래로 이동하고 범례 스티커는 상단 카드 배경에 분리 (겹침 원천 방지)
    fig.update_layout(
        map=dict(style="open-street-map", center=dict(lat=34.8, lon=128.2), zoom=7.0),
        margin=dict(r=10, t=60, b=45, l=10),
        title=dict(text="<b>📌 국내 연안 양식장 및 해양생물 출현 위치 공간 분포도</b>", y=0.01, x=0.5, xanchor="center", yanchor="bottom"),
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="left", x=0.0, bgcolor="rgba(255, 255, 255, 0.85)", borderwidth=1),
        font=dict(family="Malgun Gothic, Arial, sans-serif")
    )
    return fig

# 딥러닝 에포크별 손실 감소 곡선 (Loss Curve)
def create_loss_curve_chart(loss_curve):
    df_loss = pd.DataFrame({"Iteration": range(1, len(loss_curve) + 1), "Loss": loss_curve})
    fig = px.line(df_loss, x="Iteration", y="Loss", title="<b>심층 인공신경망(Deep MLP) 에포크별 손실 함수 감소 곡선</b>", markers=True)
    fig.update_traces(line=dict(color="#00ADB5", width=3))
    return fig

# 기계학습 특성 중요도 (Feature Importance)
def create_feature_importance_chart(feature_importances_dict):
    df_imp = pd.DataFrame(list(feature_importances_dict.items()), columns=["특성항목", "중요도"]).sort_values("중요도", ascending=True)
    fig = px.bar(df_imp, x="중요도", y="특성항목", orientation="h", title="<b>앙상블 기계학습(Random Forest) 특성 기여도</b>", color="중요도")
    return fig

